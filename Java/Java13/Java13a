import java.util.*;
class Main {
    public static void main(String[] args) {
        double num = 0;
        double pi = 0;
        int max = 0;
        
        
        for (int i = 0; (pi*4) != Math.PI; ++i){
            num = 1.0 / (2 * i + 1);
            if(i%2 == 1)
                num *= -1;
            pi += num;
            max = i;
        }
        System.out.println(pi *4);
        System.out.println(max);
        
    }
}