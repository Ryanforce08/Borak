import java.util.*;
class Main {
    public static void main(String[] args) {
        double num = 0;
        double pi = 0;
        
        for (int i = 0; i < 10000; ++i){
            num = 1.0 / (2 * i + 1);
            if(i%2 == 1)
                num *= -1;
            pi += num;
        }
        System.out.print(pi *4);
        
    }
}